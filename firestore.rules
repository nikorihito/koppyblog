rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && request.auth.token.get('koppyAdmin', false) == true; }
    match /blogEngagement/{articleId} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['views'])
        && request.resource.data.views == 1;
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views'])
        && request.resource.data.views == resource.data.views + 1;
      allow delete: if false;
      match /likes/{uid} {
        allow get, list: if true;
        allow create: if signedIn() && uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['createdAt'])
          && request.resource.data.createdAt == request.time;
        allow delete: if signedIn() && uid == request.auth.uid;
        allow update: if false;
      }
      match /comments/{commentId} {
        allow get, list: if true;
        allow create: if signedIn()
          && request.resource.data.keys().hasAll(['uid', 'name', 'text', 'createdAt','parentId','admin'])
          && request.resource.data.keys().hasOnly(['uid', 'name', 'text', 'createdAt','parentId','admin'])
          && request.resource.data.admin == admin()
          && (request.resource.data.parentId == null
            || (request.resource.data.parentId is string
            && request.resource.data.parentId.size() > 0
            && request.resource.data.parentId.size() <= 128
            && exists(/databases/$(database)/documents/blogEngagement/$(articleId)/comments/$(request.resource.data.parentId))))
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.name is string && request.resource.data.name.size() <= 30
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 500
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if signedIn() && (resource.data.uid == request.auth.uid || admin());
      }
    }
  }
}
